# Anthropic. Classification runs on claude-sonnet-5, drafting on claude-opus-5.
ANTHROPIC_API_KEY=

# Apify. Runs the three job-board actors pinned in config/actors.json.
APIFY_TOKEN=

# Google Sheets. Base64 of the service account JSON key, or the raw JSON.
#   base64 -w0 service-account.json
# Share the spreadsheet with the service account's client_email as an Editor,
# otherwise every call returns 403.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# Gmail on the secondary sending domain. OAuth2 with a refresh token: create the
# OAuth client in Google Cloud, run the consent flow once with scope
# https://www.googleapis.com/auth/gmail.send, and store the refresh token here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=outreach@your-secondary-domain.com

# Where the daily digest goes. Tyler's primary inbox.
DIGEST_TO=

# Email verification. Optional: without it a found address stays at status "found"
# instead of "verified", and is still sendable.
DEBOUNCE_API_KEY=

# Contact enrichment. "stub" returns no email, which keeps every lead on a manual
# channel. Vendor choice is Tyler's; adding one is a new file in
# src/providers/enrichment/ plus this variable.
ENRICHMENT_PROVIDER=stub
ENRICHMENT_API_KEY=

# Only needed if an HTTP trigger is ever added. Scheduling runs on GitHub Actions.
CRON_SECRET=

# debug | info | warn | error
LOG_LEVEL=info
