# --- Model backend -----------------------------------------------------------
# claude_code : run the model through headless Claude Code on a Claude subscription.
#               No separate API bill. This is the default.
# api         : use the Anthropic Messages API. Bills separately, but the API
#               enforces the JSON schema server-side instead of validate-and-retry.
LLM_BACKEND=claude_code

# For LLM_BACKEND=claude_code. Generate with:  claude setup-token
# Requires a Claude subscription. Store the result here and as a repo secret.
CLAUDE_CODE_OAUTH_TOKEN=

# For LLM_BACKEND=api only. Leave empty on the subscription route.
ANTHROPIC_API_KEY=

# --- Sources -----------------------------------------------------------------
# Apify. Runs the three job-board actors pinned in config/actors.json.
APIFY_TOKEN=

# --- Storage -----------------------------------------------------------------
# Base64 of the service account JSON key, or the raw JSON.
#   base64 -w0 service-account.json
# Share the spreadsheet with the service account's client_email as an Editor,
# otherwise every call returns 403.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# --- Sending -----------------------------------------------------------------
# Gmail on the secondary domain. OAuth2 with a refresh token: create the OAuth
# client in Google Cloud, run the consent flow once with scope
# https://www.googleapis.com/auth/gmail.send, and store the refresh token here.
# Leave these empty and the pipeline runs everything except sending, writing the
# digest to stdout.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=outreach@your-secondary-domain.com

# Where the daily digest goes.
DIGEST_TO=

# --- Enrichment --------------------------------------------------------------
# Optional. Without it a found address stays "found" instead of "verified",
# and is still sendable.
DEBOUNCE_API_KEY=

# "stub" returns no email, which keeps every lead on a manual channel. Adding a
# vendor is one new file in src/providers/enrichment/ plus this variable.
ENRICHMENT_PROVIDER=stub
ENRICHMENT_API_KEY=

# --- Misc --------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
